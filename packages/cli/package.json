{
  "name": "@formation/cli",
  "version": "0.0.0",
  "description": "Generate form components for your stack from a schema.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "formation": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "node ./dist/bin.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@formation/core": "workspace:*",
    "@formation/framework-react": "workspace:*",
    "@formation/ingest-json-schema": "workspace:*",
    "@formation/ingest-zod": "workspace:*",
    "@formation/registry": "workspace:*",
    "@formation/schema-zod": "workspace:*",
    "@formation/state-zustand": "workspace:*",
    "@formation/ui-mui": "workspace:*",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.6.2",
    "yaml": "^2.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
