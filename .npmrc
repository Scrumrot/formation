# Workspace packages resolve to each other by link, not by fetching from the
# registry, even when a semver range would also match a published version.
link-workspace-packages=true

# Adapters are published independently and third parties will author their own;
# a strict store keeps a missing peer dep from being silently satisfied by
# whatever happened to hoist.
strict-peer-dependencies=false
auto-install-peers=true
