{
  "name": "@formation/example-golden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Golden project: generated forms for every supported stack, typechecked and run against the real libraries.",
  "scripts": {
    "generate": "node ./generate.mjs",
    "typecheck": "tsc -p tsconfig.zustand-mui9.json && tsc -p tsconfig.zustand-mui7.json && tsc -p tsconfig.formstand-mui9.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "formstand": "^0.26.1",
    "mui7": "npm:@mui/material@^7.3.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@formation/cli": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
