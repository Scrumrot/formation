{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // MUI 7 is installed beside 9 under the alias `mui7`. Pointing the bare
    // specifier at it typechecks the mui@7 output against 7's real declarations.
    "paths": {
      "@mui/material": ["./node_modules/mui7"],
      "@mui/material/*": ["./node_modules/mui7/*"]
    }
  },
  "include": ["schemas", "src/generated/zustand-mui7"]
}
